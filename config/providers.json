{
  "default_provider": "groq",
  "default_model": "openai/gpt-oss-20b",
  "providers": {
    "groq": {
      "display_name": "Groq",
      "description": "GroqCloud OpenAI-compatible API",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "enabled": true,
      "timeout_seconds": 60
    }
  }
}