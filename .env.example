# Docker Compose — copy this file to .env before using non-default credentials.
POSTGRES_DB=lords_mobile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-sharing

# Spring Boot
SERVER_PORT=8080
BACKEND_HOST_PORT=8081
APP_JWT_SECRET=change-me-with-a-long-random-secret
APP_JWT_EXPIRATION_MS=86400000
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=90000
CHAT_REQUESTS_PER_MINUTE=30

# Optional bootstrap administrator. Keep disabled unless all values are set.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=

# RAG
QDRANT_COLLECTION=lords_mobile_knowledge
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K=8
MAX_UPLOAD_BYTES=20971520

# Agent — configure the matching provider in config/providers.json.
LOCAL_OPENAI_API_KEY=
GROQ_API_KEY=
TOKEN_FACTORY_API_KEY=
